      const sourceList = isArchiveView ? archivedDelivered : allOrders;

      const filtered = sourceList.filter((order) => {
        const est = order.estado || "Recibido";
        if (currentFilter === "ACTIVOS" && est === "Entregado") return false;
        if (!isArchiveView && currentFilter !== "ALL" && currentFilter !== "ACTIVOS" && est !== currentFilter) {
          return false;
        }

        if (searchTerm) {
          const haystack = `${order.folio || ""} ${order.clienteNombre || ""} ${order.clienteTelefono || ""} ${order.direccion || ""} ${order.taqueriaNombre || ""}`.toLowerCase();
          if (!haystack.includes(searchTerm)) return false;
