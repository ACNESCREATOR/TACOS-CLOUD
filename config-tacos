                </div>
              </div>
            </article>
          `;
        })
        .join("");

      grid.querySelectorAll("[data-set-status]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const orderId = btn.dataset.orderId;
          const nuevoEstado = btn.dataset.setStatus;
          const isLocal = btn.dataset.isLocal === "1";

          if (nuevoEstado === "Entregado") {
            openEntregaConfirmation(orderId, isLocal);
            return;
          }

          btn.disabled = true;
          await applyStatusChange(orderId, nuevoEstado, isLocal, null);
        });
      });

      grid.querySelectorAll("[data-cloud-chat-form]").forEach((formEl) => {
        formEl.addEventListener("submit", async (e) => {
          e.preventDefault();
          const inputEl = formEl.querySelector("input");
          const texto = inputEl ? inputEl.value.trim() : "";
          if (!texto) return;

          const chatKey = formEl.dataset.chatKey;
          const orderId = formEl.dataset.orderId;
          const isLocal = formEl.dataset.isLocal === "1";

          if (inputEl) inputEl.value = "";

          appendLocalChat(chatKey, {
            remitente: "TACOS CLOUD",
            rol: "cloud",
            texto
          });

          const box = document.querySelector(`[data-chat-box="${chatKey}"]`);
          if (box) {
            box.innerHTML = renderChatBubblesHtml(readLocalChat(chatKey));
            box.scrollTop = box.scrollHeight;
          }

          if (db && !isLocal && orderId) {
            try {
              await addDoc(collection(db, COLLECTION_PEDIDOS, orderId, "mensajes"), {
                remitente: "TACOS CLOUD",
                rol: "cloud",
                texto,
                creadoEn: serverTimestamp()
              });
            } catch {
              // Queda en respaldo local
            }
          }
        });
      });

      grid.querySelectorAll("[data-delete-order]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const orderId = btn.dataset.deleteOrder;
          const isLocal = btn.dataset.isLocal === "1";
          if (!confirm("¿Eliminar este pedido del historial?")) return;
          await removeOrder(orderId, isLocal);
        });
      });
    }

    async function applyStatusChange(orderId, nuevoEstado, isLocal, orderObj) {
      const targetOrder = orderObj || allOrders.find((o) => o.id === orderId) || null;

      if (nuevoEstado === "Entregado" && targetOrder) {
        archiveDeliveredOrder(targetOrder);
      }

      if (isLocal || !db) {
        try {
          const raw = localStorage.getItem(LOCAL_BACKUP_KEY);
          const arr = raw ? JSON.parse(raw) : [];
          const idx = arr.findIndex((item, i) => (item.id || `local-${i}`) === orderId);
          if (idx !== -1) {
            arr[idx].estado = nuevoEstado;
            localStorage.setItem(LOCAL_BACKUP_KEY, JSON.stringify(arr));
          }
        } catch {
          // Sin acción
        }
        loadLocalBackupOrders();
        return;
      }

      try {
        await updateDoc(doc(db, COLLECTION_PEDIDOS, orderId), {
          estado: nuevoEstado,
          ultimaActualizacion: serverTimestamp()
        });
      } catch (err) {
        console.error("Error actualizando estatus:", err);
      }
      updateKPIs();
      renderOrdersGrid();
    }

    async function removeOrder(orderId, isLocal) {
      if (isLocal || !db) {
        try {
          const raw = localStorage.getItem(LOCAL_BACKUP_KEY);
          const arr = raw ? JSON.parse(raw) : [];
          const filtered = arr.filter((item, i) => (item.id || `local-${i}`) !== orderId);
          localStorage.setItem(LOCAL_BACKUP_KEY, JSON.stringify(filtered));
        } catch {
          // Sin acción
        }
        loadLocalBackupOrders();
        return;
      }

      try {
        await deleteDoc(doc(db, COLLECTION_PEDIDOS, orderId));
      } catch (err) {
        console.error("Error eliminando pedido:", err);
      }
    }

    function loadLocalBackupOrders() {
      try {
        const raw = localStorage.getItem(LOCAL_BACKUP_KEY);
        const arr = raw ? JSON.parse(raw) : [];
        allOrders = arr.map((item, idx) => ({
          ...item,
          id: item.id || `local-${idx}`,
          _isLocalBackup: true
        }));
      } catch {
        allOrders = [];
      }
      syncFirestoreDeliveredToArchive(allOrders);
      updateKPIs();
      renderOrdersGrid();
    }

    document.querySelectorAll(".cloud-filter-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        currentFilter = btn.dataset.statusFilter;
        document.querySelectorAll(".cloud-filter-btn").forEach((b) => {
          const isArchiveBtn = b.dataset.statusFilter === "ARCHIVO_ENTREGADOS";
          b.classList.remove("bg-tc-accent", "text-white", "font-semibold");
          b.classList.add(
            "bg-tc-panel",
            isArchiveBtn ? "text-emerald-300" : "text-[#D1D5DB]",
            "border",
            isArchiveBtn ? "border-emerald-500/35" : "border-tc-line",
            "font-medium"
          );
        });
        btn.classList.remove("bg-tc-panel", "text-[#D1D5DB]", "text-emerald-300", "border", "border-tc-line", "border-emerald-500/35", "font-medium");
        btn.classList.add("bg-tc-accent", "text-white", "font-semibold");
        renderOrdersGrid();
      });
    });

    document.getElementById("searchOrdersInput").addEventListener("input", (e) => {
      searchTerm = e.target.value.trim().toLowerCase();
      renderOrdersGrid();
    });

    function startRealtimeOrdersListener() {
      const syncText = document.getElementById("syncStatusText");
      const syncDot = document.getElementById("syncStatusDot");

      if (!db) {
        syncText.textContent = "Modo Local";
        syncDot.classList.remove("bg-emerald-400");
        syncDot.classList.add("bg-amber-400");
        loadLocalBackupOrders();
        return;
      }

      const pedidosQuery = query(
        collection(db, COLLECTION_PEDIDOS),
        orderBy("fechaCreacion", "desc")
      );

      onSnapshot(
        pedidosQuery,
        (snapshot) => {
          syncText.textContent = "En Vivo";
          syncDot.classList.remove("bg-amber-400", "bg-red-500");
          syncDot.classList.add("bg-emerald-400");

          const fetched = [];
          let hasBrandNewOrder = false;

          snapshot.forEach((docSnap) => {
            const data = docSnap.data();
            fetched.push({
              id: docSnap.id,
              ...data,
              _isLocalBackup: false
            });

            if (initialLoadCompleted && !knownOrderIds.has(docSnap.id) && (data.estado || "Recibido") === "Recibido") {
              hasBrandNewOrder = true;
            }
            knownOrderIds.add(docSnap.id);
          });

          if (hasBrandNewOrder) {
            playNewOrderChime();
          }

          initialLoadCompleted = true;
          allOrders = fetched;
          syncFirestoreDeliveredToArchive(allOrders);
          updateKPIs();
          renderOrdersGrid();
        },
        (error) => {
          console.warn("Error leyendo Firestore, usando respaldo local:", error);
          syncText.textContent = "Respaldo";
          syncDot.classList.remove("bg-emerald-400");
          syncDot.classList.add("bg-amber-400");
          loadLocalBackupOrders();
        }
      );
    }

    syncBranchControlPanel();
    startRealtimeOrdersListener();
  </script>
</body>
</html>
