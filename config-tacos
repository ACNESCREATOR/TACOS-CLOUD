      document.getElementById("scheduleOpenInput").value = branch.horario?.abre || "17:00";
      document.getElementById("scheduleCloseInput").value = branch.horario?.cierra || "23:59";
      draftDaysSet = new Set(Array.isArray(branch.horario?.dias) ? branch.horario.dias : [1, 2, 3, 4, 5, 6, 0]);
      renderDayButtons();
    }

    async function persistBranchChanges(branchObj) {
      taqueriasList = taqueriasList.map((t) => (t.id === branchObj.id ? branchObj : t));
      saveTaqueriasState();
      syncBranchControlPanel();

      if (db) {
        try {
          await setDoc(
            doc(db, COLLECTION_TAQUERIAS, branchObj.id),
            {
              nombre: branchObj.nombre,
              cp: branchObj.cp,
              cerradaManualmente: Boolean(branchObj.cerradaManualmente),
              horario: branchObj.horario,
              actualizadoEn: serverTimestamp()
            },
            { merge: true }
          );
        } catch (err) {
          console.warn("No se pudo sincronizar estado de taquería en Firestore:", err);
        }
      }
    }

    document.getElementById("branchConfigSelect").addEventListener("change", (e) => {
      activeBranchId = e.target.value;
      syncBranchControlPanel();
    });

    document.getElementById("toggleManualCloseBtn").addEventListener("click", async () => {
      const branch = getActiveBranch();
      await persistBranchChanges({
        ...branch,
        cerradaManualmente: !branch.cerradaManualmente
      });
    });

    document.querySelectorAll(".day-toggle-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const dayNum = Number(btn.dataset.day);
        if (draftDaysSet.has(dayNum)) {
          if (draftDaysSet.size > 1) draftDaysSet.delete(dayNum);
        } else {
          draftDaysSet.add(dayNum);
        }
        renderDayButtons();
      });
    });

    document.getElementById("branchScheduleForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const abre = document.getElementById("scheduleOpenInput").value || "17:00";
      const cierra = document.getElementById("scheduleCloseInput").value || "23:59";
      const dias = Array.from(draftDaysSet);
      const branch = getActiveBranch();

      await persistBranchChanges({
        ...branch,
        horario: { abre, cierra, dias }
      });

      const hint = document.getElementById("scheduleSavedHint");
      hint.classList.remove("hidden");
      setTimeout(() => hint.classList.add("hidden"), 2500);
    });

    let allOrders = [];
    let archivedDelivered = readArchivedDelivered();
    let currentFilter = "ACTIVOS";
    let searchTerm = "";
    let soundEnabled = true;
    let knownOrderIds = new Set();
    let initialLoadCompleted = false;
    let pendingEntregaAction = null;

    const chatListenersByKey = new Map();
    const chatMessagesByKey = new Map();

    const ESTADOS_FLUJO = ["Recibido", "Preparando", "En camino", "Entregado"];

    const formatMoney = (val) =>
      "$" + Number(val || 0).toLocaleString("es-MX", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    function escapeHtml(str) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function formatOrderTime(ts) {
      if (!ts) return "Hace un momento";
      try {
        const date = typeof ts.toDate === "function" ? ts.toDate() : new Date(ts);
        if (Number.isNaN(date.getTime())) return "Hace un momento";
        return date.toLocaleString("es-MX", {
          day: "2-digit",
          month: "short",
          hour: "2-digit",
          minute: "2-digit"
        });
      } catch {
        return "Hace un momento";
      }
    }

    function readArchivedDelivered() {
      try {
        const raw = localStorage.getItem(ARCHIVO_ENTREGADOS_KEY);
        const arr = raw ? JSON.parse(raw) : [];
        return Array.isArray(arr) ? arr.slice(0, MAX_ARCHIVO_ENTREGADOS) : [];
      } catch {
        return [];
      }
    }

    function writeArchivedDelivered(list) {
      const trimmed = list.slice(0, MAX_ARCHIVO_ENTREGADOS);
      archivedDelivered = trimmed;
      try {
        localStorage.setItem(ARCHIVO_ENTREGADOS_KEY, JSON.stringify(trimmed));
      } catch {
        // Sin acción
      }
    }

    function archiveDeliveredOrder(orderObj) {
      if (!orderObj) return;
      const key = orderObj.folio || orderObj.id;
      const entry = {
        ...orderObj,
        estado: "Entregado",
        archivadoEn: new Date().toISOString(),
        _archivedId: orderObj._archivedId || `arch-${key}-${Date.now()}`
      };
      const withoutDup = archivedDelivered.filter((it) => (it.folio || it.id) !== key);
      writeArchivedDelivered([entry, ...withoutDup]);
    }

    function syncFirestoreDeliveredToArchive(ordersList) {
      const deliveredFromCloud = ordersList.filter((o) => o.estado === "Entregado");
      if (deliveredFromCloud.length === 0) return;

      const mergedMap = new Map();
      for (const item of archivedDelivered) {
        mergedMap.set(item.folio || item.id, item);
      }
      for (const item of deliveredFromCloud) {
        const k = item.folio || item.id;
        if (!mergedMap.has(k)) {
          mergedMap.set(k, {
            ...item,
            archivadoEn: item.archivadoEn || new Date().toISOString(),
            _archivedId: `arch-${k}`
          });
        }
      }
      writeArchivedDelivered(Array.from(mergedMap.values()).slice(0, MAX_ARCHIVO_ENTREGADOS));
    }

    const confirmEntregaModal = document.getElementById("confirmEntregaModal");
    const confirmEntregaSubtitle = document.getElementById("confirmEntregaSubtitle");
    const cancelEntregaBtn = document.getElementById("cancelEntregaBtn");
    const confirmEntregaBtn = document.getElementById("confirmEntregaBtn");

    function openEntregaConfirmation(orderId, isLocal) {
      const target = allOrders.find((o) => o.id === orderId);
      const folioLabel = target && target.folio ? ` (${target.folio})` : "";
      confirmEntregaSubtitle.textContent = `¿Estás seguro de que el pedido${folioLabel} ya fue entregado? Se guardará en la carpeta archivada de los últimos 50 entregados.`;
      pendingEntregaAction = { orderId, isLocal, orderObj: target || null };
      confirmEntregaModal.classList.remove("hidden");
    }

    function closeEntregaConfirmation() {
      pendingEntregaAction = null;
      confirmEntregaModal.classList.add("hidden");
    }

    cancelEntregaBtn.addEventListener("click", closeEntregaConfirmation);

    confirmEntregaBtn.addEventListener("click", async () => {
      if (!pendingEntregaAction) return;
      const { orderId, isLocal, orderObj } = pendingEntregaAction;
      confirmEntregaBtn.disabled = true;
      await applyStatusChange(orderId, "Entregado", isLocal, orderObj);
      confirmEntregaBtn.disabled = false;
      closeEntregaConfirmation();
