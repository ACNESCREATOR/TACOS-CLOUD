  <!-- ========================================================================
       SCRIPT MÓDULO ES6: TAQUERÍAS (CIERRE MANUAL + HORARIO) + PEDIDOS + CHAT
       ======================================================================== -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import {
      getFirestore,
      collection,
      query,
      orderBy,
      onSnapshot,
      doc,
      setDoc,
      addDoc,
      updateDoc,
      deleteDoc,
      serverTimestamp
    } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyCUeewNCmWsgOFTcpM7RVOg09Eg0mtS-Gs",
      authDomain: "acnes-clientes.firebaseapp.com",
      projectId: "acnes-clientes",
      storageBucket: "acnes-clientes.firebasestorage.app",
      messagingSenderId: "18765540716",
      appId: "1:18765540716:web:dbd0a3a17fad87c1315749"
    };

    const COLLECTION_PEDIDOS = "ake_pedidos";
    const COLLECTION_TAQUERIAS = "tacos_cloud_taquerias";
    const LOCAL_BACKUP_KEY = "tacos_cloud_pedidos_backup";
    const LOCAL_CHAT_PREFIX = "tacos_cloud_chat_";
    const ARCHIVO_ENTREGADOS_KEY = "ake_tacos_entregados_archivo";
    const TAQUERIAS_STATE_KEY = "tacos_cloud_taquerias_state";
    const MAX_ARCHIVO_ENTREGADOS = 50;

    let db = null;
    try {
      const app = initializeApp(firebaseConfig);
      db = getFirestore(app);
    } catch (err) {
      console.warn("Firebase no inicializado:", err);
    }

    const DEFAULT_TAQUERIAS = [
      {
        id: "ake-tacos-57180",
        nombre: "AKE Tacos",
        cp: "57180",
        cerradaManualmente: false,
        horario: {
          abre: "17:00",
          cierra: "23:59",
          dias: [1, 2, 3, 4, 5, 6, 0]
        }
      },
      {
        id: "afiliada-proxima-1",
        nombre: "Taquería Afiliada #2",
        cp: "57200",
        cerradaManualmente: false,
        horario: {
          abre: "18:00",
          cierra: "23:30",
          dias: [1, 2, 3, 4, 5, 6, 0]
        }
      }
    ];

    function loadSavedTaqueriasState() {
      try {
        const raw = localStorage.getItem(TAQUERIAS_STATE_KEY);
        if (!raw) return DEFAULT_TAQUERIAS;
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) && parsed.length > 0 ? parsed : DEFAULT_TAQUERIAS;
      } catch {
        return DEFAULT_TAQUERIAS;
      }
    }

    let taqueriasList = loadSavedTaqueriasState();
    let activeBranchId = taqueriasList[0].id;
    let draftDaysSet = new Set();

    function saveTaqueriasState() {
      try {
        localStorage.setItem(TAQUERIAS_STATE_KEY, JSON.stringify(taqueriasList));
      } catch {
        // Sin acción
      }
    }

    function getActiveBranch() {
      return taqueriasList.find((t) => t.id === activeBranchId) || taqueriasList[0];
    }

    function parseHhMmToMinutes(hhmm) {
      if (!hhmm || !hhmm.includes(":")) return null;
      const [h, m] = hhmm.split(":").map(Number);
      if (Number.isNaN(h) || Number.isNaN(m)) return null;
      return h * 60 + m;
    }

    function isWithinSchedule(horario) {
      if (!horario) return true;
      const now = new Date();
      const dayNow = now.getDay();
      const allowedDays = Array.isArray(horario.dias) ? horario.dias : [1, 2, 3, 4, 5, 6, 0];
      if (!allowedDays.includes(dayNow)) return false;

      const openMin = parseHhMmToMinutes(horario.abre);
      const closeMin = parseHhMmToMinutes(horario.cierra);
      if (openMin === null || closeMin === null) return true;

      const curMin = now.getHours() * 60 + now.getMinutes();
      if (closeMin >= openMin) {
        return curMin >= openMin && curMin <= closeMin;
      }
      // Cruza medianoche
      return curMin >= openMin || curMin <= closeMin;
    }

    function renderDayButtons() {
      document.querySelectorAll(".day-toggle-btn").forEach((btn) => {
        const dayNum = Number(btn.dataset.day);
        const active = draftDaysSet.has(dayNum);
        btn.className = `day-toggle-btn px-2.5 py-1.5 rounded-lg text-xs font-bold border transition cursor-pointer ${
          active
            ? "bg-tc-accent text-white border-tc-accent"
            : "bg-tc-bg text-tc-muted border-tc-line hover:text-white"
        }`;
      });
    }

    function syncBranchControlPanel() {
      const selectEl = document.getElementById("branchConfigSelect");
      selectEl.innerHTML = taqueriasList
        .map((t) => `<option value="${escapeHtml(t.id)}" ${t.id === activeBranchId ? "selected" : ""}>${escapeHtml(t.nombre)} (CP ${escapeHtml(t.cp)})</option>`)
        .join("");

      const branch = getActiveBranch();
      document.getElementById("branchCpTag").textContent = `CP ${branch.cp || "57180"}`;

      const inSchedule = isWithinSchedule(branch.horario);
      const badge = document.getElementById("branchEffectiveStatusBadge");
      const manualBtn = document.getElementById("toggleManualCloseBtn");

      if (branch.cerradaManualmente) {
        badge.textContent = "● Cerrada manualmente";
        badge.className = "px-3 py-1 rounded-full text-xs font-bold border bg-red-500/15 text-red-300 border-red-500/40";
        manualBtn.textContent = "🔓 Abrir taquería manualmente";
        manualBtn.className = "font-display px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition cursor-pointer";
      } else if (!inSchedule) {
        badge.textContent = "● Fuera de horario";
        badge.className = "px-3 py-1 rounded-full text-xs font-bold border bg-amber-500/15 text-amber-300 border-amber-500/40";
        manualBtn.textContent = "🔒 Cerrar taquería manualmente";
        manualBtn.className = "font-display px-4 py-2.5 rounded-xl bg-tc-accent hover:bg-tc-accentHover text-white text-xs font-bold transition cursor-pointer";
      } else {
        badge.textContent = `● Abierta (${branch.horario?.abre || "17:00"} - ${branch.horario?.cierra || "23:59"})`;
        badge.className = "px-3 py-1 rounded-full text-xs font-bold border bg-emerald-500/15 text-emerald-300 border-emerald-500/40";
        manualBtn.textContent = "🔒 Cerrar taquería manualmente";
        manualBtn.className = "font-display px-4 py-2.5 rounded-xl bg-tc-accent hover:bg-tc-accentHover text-white text-xs font-bold transition cursor-pointer";
