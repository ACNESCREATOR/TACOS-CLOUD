    function playNewOrderChime() {
      if (!soundEnabled) return;
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(660, ctx.currentTime);
        osc.frequency.setValueAtTime(880, ctx.currentTime + 0.14);
        gain.gain.setValueAtTime(0.14, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.42);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.42);
      } catch {
        // Sin acción
      }
    }

    const toggleSoundBtn = document.getElementById("toggleSoundBtn");
    toggleSoundBtn.addEventListener("click", () => {
      soundEnabled = !soundEnabled;
      document.getElementById("soundIcon").textContent = soundEnabled ? "🔔" : "🔕";
      document.getElementById("soundLabel").textContent = soundEnabled ? "Timbre Activo" : "Silenciado";
      if (soundEnabled) playNewOrderChime();
    });

    function getStatusBadgeStyle(estado) {
      switch (estado) {
        case "Preparando":
          return "bg-amber-500/15 text-amber-300 border-amber-500/40";
        case "En camino":
          return "bg-sky-500/15 text-sky-300 border-sky-500/40";
        case "Entregado":
          return "bg-emerald-500/15 text-emerald-300 border-emerald-500/40";
        default:
          return "bg-tc-accentSoft text-tc-accent border-tc-accent/40";
      }
    }

    function updateKPIs() {
      const recibidos = allOrders.filter((o) => (o.estado || "Recibido") === "Recibido").length;
      const preparando = allOrders.filter((o) => o.estado === "Preparando").length;
      const archivedLen = archivedDelivered.length;
      const ventaTotal = allOrders.reduce((acc, o) => acc + Number(o.total || 0), 0);

      document.getElementById("kpiRecibidos").textContent = String(recibidos);
      document.getElementById("kpiPreparando").textContent = String(preparando);
      document.getElementById("kpiArchivadosCount").textContent = `${archivedLen} / ${MAX_ARCHIVO_ENTREGADOS}`;
      document.getElementById("filterArchivoBadge").textContent = String(archivedLen);
      document.getElementById("archiveCountSummary").textContent = `${archivedLen} de ${MAX_ARCHIVO_ENTREGADOS} guardados`;
      document.getElementById("kpiVentasTotal").textContent = formatMoney(ventaTotal);
      document.getElementById("kpiTotalOrdenes").textContent = `${allOrders.length} ${allOrders.length === 1 ? "pedido registrado" : "pedidos registrados"}`;
    }

    function buildWhatsAppHref(order) {
      const cleanPhone = String(order.clienteTelefono || "").replace(/\D/g, "");
      const phoneWithMx = cleanPhone.length === 10 ? `52${cleanPhone}` : cleanPhone;
      const estado = order.estado || "Recibido";
      const texto = `¡Hola ${order.clienteNombre || ""}! Te escribimos de *${order.taqueriaNombre || "TACOS CLOUD"}* respecto a tu pedido *${order.folio || ""}*. Estatus actual: *${estado}*.`;
      return `https://wa.me/${phoneWithMx}?text=${encodeURIComponent(texto)}`;
    }

    function buildMapsHref(order) {
      if (order.mapsUrl) return order.mapsUrl;
      if (order.ubicacionGps && order.ubicacionGps.lat && order.ubicacionGps.lng) {
        return `https://maps.google.com/?q=${order.ubicacionGps.lat},${order.ubicacionGps.lng}`;
      }
      if (order.direccion) {
        return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(order.direccion)}`;
      }
      return "";
    }

    function readLocalChat(chatKey) {
      try {
        const raw = localStorage.getItem(LOCAL_CHAT_PREFIX + chatKey);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function appendLocalChat(chatKey, msg) {
      try {
        const arr = readLocalChat(chatKey);
        arr.push({ ...msg, creadoEn: new Date().toISOString() });
        localStorage.setItem(LOCAL_CHAT_PREFIX + chatKey, JSON.stringify(arr.slice(-80)));
      } catch {
        // Sin acción
      }
    }

    function getOrderChatMessages(order) {
      const chatKey = order._isLocalBackup ? (order.folio || order.id) : order.id;
      const liveMsgs = chatMessagesByKey.get(chatKey);
      if (liveMsgs && liveMsgs.length > 0) return liveMsgs;
      return readLocalChat(chatKey);
    }

    function ensureChatListenerForOrder(order) {
      const chatKey = order._isLocalBackup ? (order.folio || order.id) : order.id;
      if (!db || order._isLocalBackup || !order.id || chatListenersByKey.has(chatKey)) return;

      const msgsQuery = query(
        collection(db, COLLECTION_PEDIDOS, order.id, "mensajes"),
        orderBy("creadoEn", "asc")
      );

      const unsub = onSnapshot(msgsQuery, (snap) => {
        const list = [];
        snap.forEach((d) => list.push({ id: d.id, ...d.data() }));
        chatMessagesByKey.set(chatKey, list);
        const container = document.querySelector(`[data-chat-box="${chatKey}"]`);
        if (container) {
          container.innerHTML = renderChatBubblesHtml(list);
          container.scrollTop = container.scrollHeight;
        }
      });

      chatListenersByKey.set(chatKey, unsub);
    }

    function renderChatBubblesHtml(messages) {
      if (!Array.isArray(messages) || messages.length === 0) {
        return `<p class="text-[11px] text-tc-muted text-center py-2">Sin mensajes aún en este pedido.</p>`;
      }
      return messages
        .map((m) => {
          const isCloud = m.remitente === "TACOS CLOUD" || m.remitente === "AKE Tacos Cloud" || m.rol === "cloud";
          return `
            <div class="flex ${isCloud ? "justify-end" : "justify-start"}">
              <div class="max-w-[85%] rounded-xl px-2.5 py-1.5 border ${
                isCloud
                  ? "bg-tc-accent/20 border-tc-accent/40 text-white"
                  : "bg-tc-panel border-tc-line text-[#E5E7EB]"
              }">
                <span class="block text-[9px] font-bold uppercase tracking-wider ${
                  isCloud ? "text-tc-maiz" : "text-emerald-400"
                }">${escapeHtml(m.remitente || (isCloud ? "TACOS CLOUD" : "Cliente"))}</span>
                <p class="text-[11px] leading-snug break-words">${escapeHtml(m.texto || "")}</p>
              </div>
            </div>
          `;
        })
        .join("");
    }

    function renderOrdersGrid() {
