          colors: {
            tc: {
              bg: '#080707',
              surface: '#110E0E',
              panel: '#181313',
              line: 'rgba(250, 204, 21, 0.16)',
              muted: '#B5AEA8',
              accent: '#E11D2E',
              accentHover: '#BE1224',
              accentSoft: 'rgba(225, 29, 46, 0.18)',
              yellow: '#FACC15',
              yellowHover: '#EAB308',
              yellowSoft: 'rgba(250, 204, 21, 0.16)',
            }
          }
        }
      }
    };
  </script>

  <style>
    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      background-color: #080707;
      color: #F7F5F2;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
    }

    .tc-pastor-bg {
