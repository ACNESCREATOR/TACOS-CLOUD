    </section>

    <!-- ========================================================================
         3. FILTROS DE ESTADO + ÓRDENES EXCLUSIVAS DE AKE TACOS
         ======================================================================== -->
    <section class="space-y-5">

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-tc-line">
        <div>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-white">
