</head>

<body class="bg-tc-bg text-[#F7F5F2] tc-pastor-bg antialiased selection:bg-tc-yellow selection:text-black">

  <!-- ========================================================================
       1. BARRA SUPERIOR STICKY — PANEL EXCLUSIVO AKE TACOS
