        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar órdenes de AKE Tacos por estado">
          <button type="button" data-ake-filter="ALL"
            class="ake-filter-btn font-display px-3.5 py-2 rounded-xl text-xs font-bold bg-tc-accent text-white border border-tc-yellow/40 transition cursor-pointer">
