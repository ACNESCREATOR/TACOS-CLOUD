      </div>

      <!-- Métricas de AKE Tacos -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-tc-surface rounded-xl p-4 border border-tc-line">
          <span class="text-[11px] font-bold uppercase tracking-wider text-tc-muted block">Órdenes Activas</span>
          <strong id="akeMetricActivas" class="font-display text-2xl sm:text-3xl font-extrabold text-tc-yellow mt-1 block">0</strong>
        </div>
        <div class="bg-tc-surface rounded-xl p-4 border border-tc-line">
          <span class="text-[11px] font-bold uppercase tracking-wider text-tc-muted block">Recibidas / Preparando</span>
          <strong id="akeMetricCocina" class="font-display text-2xl sm:text-3xl font-extrabold text-white mt-1 block">0</strong>
        </div>
        <div class="bg-tc-surface rounded-xl p-4 border border-tc-line">
