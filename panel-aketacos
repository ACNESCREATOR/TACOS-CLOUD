      <!-- Control de Apertura / Cierre y Horario de AKE Tacos -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-center bg-tc-bg/90 rounded-xl p-4 border border-tc-line">

        <div class="lg:col-span-5 flex flex-wrap items-center justify-between gap-3">
