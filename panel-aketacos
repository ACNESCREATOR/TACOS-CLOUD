        linear-gradient(180deg, rgba(8, 7, 7, 0.85) 0%, rgba(8, 7, 7, 0.94) 50%, rgba(8, 7, 7, 0.98) 100%),
        radial-gradient(circle at 18% 12%, rgba(225, 29, 46, 0.22), transparent 55%),
