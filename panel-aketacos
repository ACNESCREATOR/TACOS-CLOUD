  <main class="max-w-7xl mx-auto px-4 sm:px-8 py-8 space-y-8">

    <!-- ========================================================================
         2. ENCABEZADO DE AKE TACOS + CONTROL DE OPERACIÓN Y MÉTRICAS
         ======================================================================== -->
    <section class="bg-tc-panel/95 backdrop-blur-md rounded-2xl p-6 border border-tc-line space-y-6">

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-tc-line">
        <div>
          <span class="font-display text-xs font-bold uppercase tracking-[0.18em] text-tc-yellow">
            Operación Exclusiva · AKE Tacos (Col. Ciudad Lago · CP 57180)
          </span>
          <h1 class="font-display text-2xl sm:text-4xl font-extrabold text-white mt-1">
