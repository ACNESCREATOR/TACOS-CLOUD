          <button type="button" data-ake-filter="Recibido"
            class="ake-filter-btn font-display px-3.5 py-2 rounded-xl text-xs font-medium bg-tc-panel text-[#E5E2DC] border border-tc-line hover:border-tc-yellow transition cursor-pointer">
            Recibido
          </button>
          <button type="button" data-ake-filter="Preparando"
            class="ake-filter-btn font-display px-3.5 py-2 rounded-xl text-xs font-medium bg-tc-panel text-[#E5E2DC] border border-tc-line hover:border-tc-yellow transition cursor-pointer">
            Preparando
          </button>
          <button type="button" data-ake-filter="En camino"
            class="ake-filter-btn font-display px-3.5 py-2 rounded-xl text-xs font-medium bg-tc-panel text-[#E5E2DC] border border-tc-line hover:border-tc-yellow transition cursor-pointer">
            En camino
          </button>
        </div>
      </div>

      <div id="akeOrdersContainer" class="grid grid-cols-1 lg:grid-cols-2 gap-6"></div>

    </section>

    <!-- ========================================================================
         4. HISTORIAL DE ENTREGADOS DE AKE TACOS (ÚLTIMAS 50)
         ======================================================================== -->
    <section class="bg-tc-surface/95 backdrop-blur-sm rounded-2xl p-6 border border-tc-line space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-tc-line">
        <div>
          <span class="font-display text-xs font-bold uppercase tracking-widest text-tc-yellow">
            Registro de Taquería
          </span>
          <h3 class="font-display text-xl sm:text-2xl font-bold text-white mt-0.5">
            Historial de Entregados · AKE Tacos (Últimas 50)
