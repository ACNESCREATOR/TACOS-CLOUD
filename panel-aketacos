  </main>

  <!-- ========================================================================
       5. FOOTER + FIRMA PRO. ACNES DIGITAL
       ======================================================================== -->
  <footer class="bg-tc-surface/95 border-t border-tc-line mt-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-tc-muted">
      <div>
        <strong class="font-display text-sm tracking-[0.12em] text-white">AKE <span class="text-tc-yellow">TACOS</span></strong>
        <span class="mx-2 text-white/20">·</span>
        <span>TACOS CLOUD · Col. Ciudad Lago · CP 57180</span>
      </div>
      <p class="font-display tracking-wider text-[#D6D1C9]">
        Pro. <span class="text-tc-yellow font-semibold">ACNES Digital</span>
      </p>
    </div>
